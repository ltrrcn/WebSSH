.cursor/

# macOS
.DS_Store

# fnOS 打包暂存目录（构建产物，由 scripts/build-fnos.sh 生成；app/ui/config 为手工维护的桌面入口仍跟踪）
packaging/fnos/app/src/
packaging/fnos/app/web/
packaging/fnos/app/package.json
packaging/fnos/app/package-lock.json
packaging/fnos/app/.npmrc
# 图标生成产物（scripts/gen-icons.mjs 从 web/assets/logo.svg 渲染，SVG 为唯一真源）
packaging/fnos/ICON.PNG
packaging/fnos/ICON_256.PNG
packaging/fnos/app/ui/images/
packaging/fnos-docker/ICON.PNG
packaging/fnos-docker/ICON_256.PNG
packaging/fnos-docker/app/ui/images/
# fnpack 构建暂存空目录（build 脚本 mkdir 创建）
packaging/*/wizard/
# fnos-docker 构建上下文（scripts/build-fnos-docker.sh rsync 同步副本；docker-compose.yaml 为源仍跟踪）
packaging/fnos-docker/app/docker/app/
# 离线镜像导出（build-fnos-docker.sh --image 双架构 tar.gz）
packaging/*/*-image-*.tar.gz
