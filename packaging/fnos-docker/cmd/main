#!/bin/bash
# WebSSH Docker 版生命周期脚本：启停由 fnOS 按 docker-project 资源处理
# status 退出码：0 运行中 / 3 未运行 / 1 失败

CONTAINER_NAME="webssh-docker"

case "$1" in
  start)
    # compose 项目的启停由系统按资源声明管理，无需额外动作
    exit 0
    ;;
  stop)
    exit 0
    ;;
  status)
    state=$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)
    if [ "$state" = "running" ]; then
      echo "running"
      exit 0
    fi
    echo "stopped"
    exit 3
    ;;
  *)
    echo "usage: $0 {start|stop|status}" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
